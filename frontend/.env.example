# Copy to .env and adjust. Only variables prefixed with VITE_ are exposed to browser code.

# Port for the Vite dev server
VITE_DEV_PORT=5173

# Where the dev server proxies /api requests (the Express backend)
VITE_API_PROXY_TARGET=http://localhost:4000

# Base URL the app uses for API calls. Leave empty to use same-origin /api (dev proxy).
VITE_API_BASE_URL=
