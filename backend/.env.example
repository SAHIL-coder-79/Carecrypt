# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 when running directly)
TRUST_PROXY=0

# PostgreSQL connection string for the API's restricted login (see database/README.md)
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://carecrypt_app:change_me_app@localhost:5432/carecrypt
# Restricted login for the ADMIN analytics API: it can read only the aggregate,
# suppressed views in the analytics schema. /api/analytics returns 503 without it.
ANALYTICS_DATABASE_URL=postgres://carecrypt_analytics:change_me_analytics@localhost:5432/carecrypt
# Set to true for hosted databases that require SSL (applies to both logins)
DATABASE_SSL=false

# JWT signing secret: required, at least 32 random characters. The server will not start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20

# RBAC demonstration endpoints under /api/test. Leave unset to enable them
# everywhere except NODE_ENV=production; set true or false to override.
# ENABLE_RBAC_TEST_ENDPOINTS=
