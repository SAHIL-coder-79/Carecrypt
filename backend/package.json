{
  "name": "carecrypt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CareCrypt API server (Express)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:check": "node scripts/db-check.js",
    "qr:cards": "node scripts/generate-demo-qr-cards.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:rbac": "node --test test/rbac.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  }
}
